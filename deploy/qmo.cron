# Run after TWSE/TPEx post-market publication. Host timezone must be Asia/Taipei.
# Install with: crontab deploy/qmo.cron
40 15 * * 1-5 cd /opt/quant-market-observer && /usr/bin/flock -n /var/lock/qmo-update.lock /usr/bin/docker compose run --rm qmo update --date latest --root-dir /var/lib/qmo/data >> /var/log/qmo-update.log 2>&1
10 16 * * 1-5 cd /opt/quant-market-observer && /usr/bin/docker compose run --rm qmo validate --root-dir /var/lib/qmo/data --format text >> /var/log/qmo-validate.log 2>&1
